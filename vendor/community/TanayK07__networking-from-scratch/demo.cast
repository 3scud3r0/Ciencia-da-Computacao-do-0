[6.913662, "o", "=== Send Your First Frame Demo ===\r\n\r\nBuilt frame: 60 bytes\r\n  dst: ff:ff:ff:ff:ff:ff (broadcast=1)\r\n  src: 00:11:22:33:44:55\r\n  ethertype: 0x0800\r\n"]
[6.913688, "o", "\r\nRe-parsed:\r\n  dst: ff:ff:ff:ff:ff:ff\r\n  src: 00:11:22:33:44:55\r\n  ethertype: 0x0800\r\n  payload (46 bytes): \"Hello from raw Ethernet!\"\r\n\r\nValid frame? yes\r\n\r\n--- MAC utilities ---\r\n"]
