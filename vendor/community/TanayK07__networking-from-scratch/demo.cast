[25.768285, "o", "=== HTTP/1.0 & HTTP/1.1 Parser ===\r\n\r\nRequest parsed (96 bytes):\r\n  Method:  GET\r\n  URI:     /index.html\r\n  Version: HTTP/1.1\r\n  Headers: 3\r\n    Host: www.example.com\r\n    User-Agent: nfs-http/1.0\r\n    Accept: text/html\r\n\r\nResponse parsed (90 bytes):\r\n  Version: HTTP/1.1\r\n  Status:  200 OK\r\n  Headers: 3\r\n    Content-Type: text/html\r\n    Content-Length: 1234\r\n    Connection: keep-alive\r\n  Content-Length: 1234\r\n\r\nBuilt request (94 bytes):\r\nGET /api/data HTTP/1.1\r\r\nHost: api.example.com\r\r\nAccept: application/json\r\r\nConnection: close\r\r\n\r\r\n\r\nStatus reasons:\r\n  200: OK\r\n  301: Moved Permanently\r\n  404: Not Found\r\n  500: Internal Server Error\r\n"]
